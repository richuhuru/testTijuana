# Copia a .env para desarrollo local (NUNCA subas .env al repo).
# En produccion, define estas variables en Render -> Environment.

# --- Prueba sin claves ---
MOCK_LLM=1
RESTAURANT_ID=tijuanas        # marcos | tijuanas

# --- Produccion (quita MOCK_LLM y llena esto) ---
# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+1787XXXXXXX
KITCHEN_NOTIFY_TO=whatsapp:+1787XXXXXXX

# LLM (OpenAI por defecto; usa un modelo claude-* para Anthropic)
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai         # opcional: openai | anthropic

# Stripe
STRIPE_SECRET_KEY=sk_live_...
SUCCESS_URL=https://www.uhurucorp.com/gracias
# CANCEL_URL=https://www.uhurucorp.com
# STRIPE_WEBHOOK_SECRET=whsec_...
